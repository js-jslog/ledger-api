{
  "name": "ledger-api",
  "version": "0.1.0",
  "description": "A REST API for a retail bank: users, accounts and transactions.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.0",
    "supertest": "^7.2.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jose": "^6.2.8",
    "json-schema-to-ts": "^3.1.1",
    "kysely": "^0.29.4",
    "neverthrow": "^8.2.0",
    "pg": "^8.22.0"
  }
}
